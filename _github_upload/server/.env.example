# این فایل رو کپی کن و اسمش رو بذار .env - خود .env هیچ‌وقت نباید commit بشه (تو .gitignore هست)

# فعلاً SQLite - یه فایل دیتابیس کنار پروژه، بدون نیاز به نصب/اکانت جایی.
# وقتی خواستیم دیپلوی کنیم این رو با یه connection string واقعی (Postgres) عوض می‌کنیم.
DATABASE_URL="file:./dev.db"

# پورتی که سرور Express روش بالا میاد
PORT=4000

# آدرس فرانت‌اند، برای تنظیم CORS (همون آدرسی که Vite دیو سرور روش اجرا می‌شه)
CLIENT_ORIGIN=http://localhost:5173

# رشته‌ی مخفی برای امضای JWT توکن‌های لاگین - هر مقدار تصادفی و بلند کافیه،
# فقط مهمه که این مقدار رو جایی به اشتراک نذاری
JWT_SECRET="change-this-to-a-random-long-string"
